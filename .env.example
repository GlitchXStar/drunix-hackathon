# TrustLedger Environment Variables (Example Template)
# Never commit real secrets or production .env files.

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://admin:password123@localhost:27017/trustledger?authSource=admin

# Security Secrets (Provide 32+ char secrets in production)
SESSION_SECRET=dev-session-secret-at-least-32-chars-long
CSRF_SECRET=dev-csrf-secret-at-least-32-chars-long
OTP_PEPPER=dev-otp-hmac-pepper-secret-random-hex

# Master Key for Envelope Encryption (32-byte Hex string for AES-256)
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage Provider (local | nextcloud)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./.storage
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=adminpassword

# Credit Risk Service
RISK_SERVICE_URL=http://localhost:8001
RISK_INTERNAL_TOKEN=dev-internal-token-secret

# Ledger Configuration (in-memory | fabric)
LEDGER_TYPE=in-memory
DRUNIX_PEER_ENDPOINT=localhost:7051
DRUNIX_CHANNEL=trustledgerchannel
DRUNIX_CHAINCODE=trustledger

# Development Helpers
DEV_OUTBOX=1
